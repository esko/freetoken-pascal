{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/esko/freetoken-pascal/schemas/hardware-inventory.schema.json",
  "title": "FreeToken-Pascal hardware inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "evidence_status", "captured_at", "commit", "host", "gpus", "software"],
  "properties": {
    "schema_name": {"const": "hardware-inventory.schema.json"},
    "schema_version": {"const": 1},
    "evidence_status": {"enum": ["synthetic", "measured"]},
    "captured_at": {"type": "string", "format": "date-time"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostname", "os", "cpu", "numa_nodes", "memory_bytes"],
      "properties": {
        "hostname": {"type": "string", "minLength": 1},
        "os": {"type": "string", "minLength": 1},
        "cpu": {"type": "string", "minLength": 1},
        "numa_nodes": {"type": "integer", "minimum": 1},
        "memory_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "gpus": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "name", "compute_capability", "memory_mib", "pci_bus_id", "driver", "uuid", "clocks"],
        "properties": {
          "index": {"type": "integer", "minimum": 0},
          "name": {"type": "string", "minLength": 1},
          "compute_capability": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
          "memory_mib": {"type": "integer", "minimum": 1},
          "pci_bus_id": {"type": "string", "minLength": 1},
          "driver": {"type": "string", "minLength": 1},
          "uuid": {"type": "string", "minLength": 1},
          "ecc_mode": {"enum": ["enabled", "disabled", "n/a"]},
          "clocks": {
            "type": "object",
            "additionalProperties": false,
            "required": ["graphics_mhz", "memory_mhz"],
            "properties": {
              "graphics_mhz": {"type": "integer", "minimum": 1},
              "memory_mhz": {"type": "integer", "minimum": 1}
            }
          },
          "topology": {"$ref": "#/$defs/topology"},
          "pci_link": {"$ref": "#/$defs/gpu_pci_link"}
        }
      }
    },
    "software": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cuda_driver", "cuda_toolkit", "torch", "triton"],
      "properties": {
        "cuda_driver": {"type": "string", "minLength": 1},
        "cuda_runtime": {"type": "string", "minLength": 1},
        "cuda_toolkit": {"type": "string", "minLength": 1},
        "nvidia_container_toolkit": {"type": "string", "minLength": 1},
        "torch": {"type": "string", "minLength": 1},
        "torch_cuda_device_count": {"type": "integer", "minimum": 0},
        "triton": {"type": "string", "minLength": 1}
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nvme"],
      "properties": {
        "nvme": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "model", "serial", "pci_bus_id", "topology", "pci_link", "mounts"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "model": {"type": "string", "minLength": 1},
              "serial": {"type": "string", "minLength": 1},
              "pci_bus_id": {"type": "string", "minLength": 1},
              "topology": {"$ref": "#/$defs/topology"},
              "pci_link": {"$ref": "#/$defs/pci_link"},
              "mounts": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
            }
          }
        }
      }
    },
    "thermal_qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "load_test", "throttling", "reason"],
      "properties": {
        "status": {"enum": ["unqualified", "qualified"]},
        "load_test": {"type": "string", "minLength": 1},
        "throttling": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deterministic", "commands"],
      "properties": {
        "deterministic": {"type": "boolean"},
        "commands": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"evidence_status": {"const": "measured"}},
        "required": ["evidence_status"]
      },
      "then": {
        "required": ["storage", "thermal_qualification", "capture"],
        "properties": {
          "gpus": {
            "items": {
              "required": ["ecc_mode", "topology", "pci_link"]
            }
          },
          "software": {
            "required": ["cuda_runtime", "nvidia_container_toolkit", "torch_cuda_device_count"]
          }
        }
      }
    }
  ],
  "$defs": {
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numa_node", "pci_root", "sysfs_path"],
      "properties": {
        "numa_node": {"type": "integer", "minimum": 0},
        "pci_root": {"type": "string", "minLength": 1},
        "sysfs_path": {"type": "string", "minLength": 1}
      }
    },
    "pci_link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum", "current"],
      "properties": {
        "maximum": {"$ref": "#/$defs/pci_link_state"},
        "current": {"$ref": "#/$defs/pci_link_state"}
      }
    },
    "gpu_pci_link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum", "current", "current_is_idle", "load_qualified", "qualification"],
      "properties": {
        "maximum": {"$ref": "#/$defs/pci_link_state"},
        "current": {"$ref": "#/$defs/pci_link_state"},
        "current_is_idle": {"type": "boolean"},
        "load_qualified": {"type": "boolean"},
        "qualification": {"type": "string", "minLength": 1}
      }
    },
    "pci_link_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation", "width"],
      "properties": {
        "generation": {"type": "integer", "minimum": 1},
        "width": {"type": "integer", "minimum": 1}
      }
    }
  }
}
