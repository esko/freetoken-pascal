{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/esko/freetoken-pascal/schemas/quant-census.schema.json",
  "title": "FreeToken-Pascal quantization census",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name", "schema_version", "evidence_status", "architecture",
    "model_sha256", "shard_count", "shards", "tensor_count", "total_bytes",
    "by_quant_type", "expert_layers", "expert_pools", "expert_slot_pools",
    "host_memory", "tensors"
  ],
  "dependentRequired": {
    "sensitive_tensors": ["sensitive_policy"],
    "sensitive_policy": ["sensitive_tensors"]
  },
  "properties": {
    "schema_name": {"const": "quant-census.schema.json"},
    "schema_version": {"const": 3},
    "evidence_status": {"enum": ["synthetic", "artifact-metadata", "measured"]},
    "architecture": {"type": "string", "minLength": 1},
    "model_sha256": {"$ref": "#/$defs/sha256"},
    "shard_count": {"type": "integer", "minimum": 1},
    "shards": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "size", "sha256", "sha256_status"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "size": {"type": "integer", "minimum": 1},
          "sha256": {"$ref": "#/$defs/sha256"},
          "sha256_status": {"enum": ["declared", "verified"]}
        }
      }
    },
    "tensor_count": {"type": "integer", "minimum": 0},
    "total_bytes": {"type": "integer", "minimum": 0},
    "by_quant_type": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["tensors", "bytes"],
        "properties": {
          "tensors": {"type": "integer", "minimum": 0},
          "bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "expert_layers": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["layer", "experts", "projections", "quant_types"],
        "properties": {
          "layer": {"type": "integer", "minimum": 0},
          "experts": {"type": "integer", "minimum": 1},
          "projections": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "quant_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    },
    "expert_pools": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["layer", "projection", "tensor", "experts", "shape", "quant_type", "bytes"],
        "properties": {
          "layer": {"type": "integer", "minimum": 0},
          "projection": {"type": "string", "minLength": 1},
          "tensor": {"type": "string", "minLength": 1},
          "experts": {"type": "integer", "minimum": 1},
          "shape": {"$ref": "#/$defs/shape"},
          "quant_type": {"type": "string", "minLength": 1},
          "bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "expert_slot_pools": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["pool_id", "projection", "quant_type", "shape_per_expert", "packed_row_bytes", "bytes_per_slot", "layers"],
        "properties": {
          "pool_id": {"type": "integer", "minimum": 0},
          "projection": {"type": "string", "minLength": 1},
          "quant_type": {"type": "string", "minLength": 1},
          "shape_per_expert": {"type": "array", "items": {"type": "integer", "minimum": 1}},
          "packed_row_bytes": {"type": "integer", "minimum": 1},
          "bytes_per_slot": {"type": "integer", "minimum": 1},
          "layers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}}
        }
      }
    },
    "host_memory": {
      "type": "object", "additionalProperties": false,
      "required": ["total_file_backed_tensor_bytes", "ordinary_tensor_bytes", "expert_mapped_bytes", "ple_mapped_bytes", "anonymous_host_source_bytes", "pinned_host_source_bytes"],
      "properties": {
        "total_file_backed_tensor_bytes": {"type": "integer", "minimum": 0},
        "ordinary_tensor_bytes": {"type": "integer", "minimum": 0},
        "expert_mapped_bytes": {"type": "integer", "minimum": 0},
        "ple_mapped_bytes": {"type": "integer", "minimum": 0},
        "anonymous_host_source_bytes": {"const": 0},
        "pinned_host_source_bytes": {"const": 0}
      }
    },
    "tensors": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "shape", "quant_type", "quant_name", "shard_index", "offset", "nbytes", "rows", "row_bytes"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "shape": {"$ref": "#/$defs/shape"},
          "quant_type": {"type": "integer", "minimum": 0},
          "quant_name": {"type": "string", "minLength": 1},
          "shard_index": {"type": "integer", "minimum": 0},
          "offset": {"type": "integer", "minimum": 0},
          "nbytes": {"type": "integer", "minimum": 0},
          "rows": {"type": "integer", "minimum": 1},
          "row_bytes": {"type": "integer", "minimum": 1}
        }
      }
    },
    "sensitive_tensors": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/sensitive_tensor"}
    },
    "sensitive_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_name", "schema_version", "profile", "expert_rule",
        "sensitive_rule", "baseline", "allowed_formats", "sub8_default", "q8_promotion",
        "serving_qualification",
        "long_horizon_semantic_gate"
      ],
      "properties": {
        "schema_name": {"const": "sensitive-tensor-precision-policy"},
        "schema_version": {"const": 1},
        "profile": {"type": "string", "minLength": 1},
        "expert_rule": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope", "match", "sensitive_exclusion"],
          "properties": {
            "scope": {"const": "routed-expert-tensors-only"},
            "match": {"type": "string", "minLength": 1},
            "sensitive_exclusion": {"const": true}
          }
        },
        "sensitive_rule": {"const": "exact-identity-only"},
        "baseline": {"type": "string", "minLength": 1},
        "allowed_formats": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "sub8_default": {"const": "reject"},
        "q8_promotion": {"const": "per-class-evidence-required"},
        "serving_qualification": {"const": "blocked-until-sensitive-evidence"},
        "long_horizon_semantic_gate": {"const": "deferred"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "shape": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
    "sensitive_tensor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity", "name", "class", "dtype", "quant_format", "dtype_or_quant",
        "scale_representation", "conversion_provenance", "selected_precision", "rationale",
        "promotion_status", "promotion_evidence"
      ],
      "properties": {
        "identity": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "class": {
          "enum": [
            "moe_router", "shared_expert_gate", "shared_expert_gate_scale",
            "gdn_in_proj_a", "gdn_in_proj_b", "gdn_state_projection", "gdn_control",
            "gdn_output_gate", "hyperconnection_control", "residual_write_gate", "norm",
            "reference_control"
          ]
        },
        "dtype": {"type": ["string", "null"]},
        "quant_format": {"type": "string", "minLength": 1},
        "dtype_or_quant": {"type": "string", "minLength": 1},
        "scale_representation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "location", "required"],
          "properties": {
            "kind": {"type": "string", "minLength": 1},
            "location": {"type": "string", "minLength": 1},
            "dtype": {"type": "string", "minLength": 1},
            "required": {"type": "boolean"}
          }
        },
        "conversion_provenance": {"type": "string", "minLength": 1},
        "selected_precision": {"type": "string", "minLength": 1},
        "promotion_status": {"enum": ["baseline", "unqualified", "qualified", "passed"]},
        "promotion_evidence": {"type": ["string", "null"]},
        "rationale": {"type": "string", "minLength": 1},
        "shape": {"$ref": "#/$defs/shape"}
      }
    }
  }
}
