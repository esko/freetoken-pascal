{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/esko/freetoken-pascal/schemas/correctness-evidence.schema.json",
  "title": "FreeToken-Pascal correctness evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "evidence_status", "commit", "subject", "reference", "comparisons", "passed"],
  "properties": {
    "schema_name": {"const": "correctness-evidence.schema.json"},
    "schema_version": {"const": 1},
    "evidence_status": {"enum": ["synthetic", "measured"]},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "artifact_sha256"],
      "properties": {
        "mode": {"type": "string", "minLength": 1},
        "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "revision", "artifact_sha256"],
      "properties": {
        "implementation": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "comparisons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "metric", "observed", "limit", "passed"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "metric": {"enum": ["max_abs", "max_rel", "token_exact", "state_hash"]},
          "observed": {"type": ["number", "string", "boolean"]},
          "limit": {"type": ["number", "string", "boolean"]},
          "passed": {"type": "boolean"}
        }
      }
    },
    "passed": {"type": "boolean"}
  }
}
