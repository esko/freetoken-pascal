{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/esko/freetoken-pascal/manifests/upstreams.schema.json",
  "title": "FreeToken-Pascal upstream provenance ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "updated", "policy", "sources"],
  "properties": {
    "schema_version": {"const": 2},
    "updated": {"type": "string", "format": "date"},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "require_commit_sha",
        "require_license",
        "require_responsible_issue",
        "moving_refs_are_prohibited_in_release"
      ],
      "properties": {
        "require_commit_sha": {"const": true},
        "require_license": {"const": true},
        "require_responsible_issue": {"const": true},
        "moving_refs_are_prohibited_in_release": {"const": true}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": {"pattern": "(^/|(^|/)\\.\\.(/|$))"}
    },
    "import": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_path",
        "destination_path",
        "source_ref",
        "method",
        "local_modifications",
        "license",
        "header_policy",
        "responsible_issue"
      ],
      "properties": {
        "source_path": {"$ref": "#/$defs/relativePath"},
        "destination_path": {"$ref": "#/$defs/relativePath"},
        "source_ref": {"$ref": "#/$defs/sha"},
        "method": {
          "enum": [
            "unrelated-history merge",
            "merge",
            "cherry-pick",
            "copied",
            "adapted",
            "reimplemented"
          ]
        },
        "local_modifications": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "license": {"type": "string", "minLength": 1},
        "header_policy": {
          "enum": ["preserved by history", "preserved", "SPDX added", "not applicable"]
        },
        "responsible_issue": {"type": "integer", "minimum": 1},
        "responsible_pull_request": {"type": "integer", "minimum": 1}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "repository",
        "upstream_ref",
        "ref",
        "license",
        "role",
        "usage",
        "responsible_issue",
        "notice_required",
        "imports"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "repository": {
          "type": "string",
          "pattern": "^https://github\\.com/[^/]+/[^/]+$"
        },
        "pull_request": {"type": "integer", "minimum": 1},
        "upstream_ref": {"type": "string", "pattern": "^refs/(heads|pull)/.+"},
        "ref": {"$ref": "#/$defs/sha"},
        "license": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "usage": {"enum": ["imported", "planned", "reference"]},
        "responsible_issue": {"type": "integer", "minimum": 1},
        "notice_required": {"type": "boolean"},
        "audit_blobs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha"],
            "properties": {
              "path": {"$ref": "#/$defs/relativePath"},
              "sha": {"$ref": "#/$defs/sha"}
            }
          }
        },
        "imports": {
          "type": "array",
          "items": {"$ref": "#/$defs/import"}
        }
      }
    }
  }
}
